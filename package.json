{
  "name": "budget-app",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "start": "npm --workspace server run start",
    "dev": "npm-run-all -p dev:shared dev:server dev:client",
    "dev:shared": "npm --workspace shared run build",
    "dev:server": "npm --workspace server run start:dev",
    "dev:client": "npm --workspace client start",
    "build": "npm-run-all build:shared build:server build:client",
    "build:shared": "npm --workspace shared run build",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "lint": "npm-run-all lint:shared lint:server lint:client",
    "lint:shared": "npm --workspace shared run lint",
    "lint:server": "npm --workspace server run lint",
    "lint:client": "npm --workspace client run lint"
  },
  "dependencies": {
    "@nestjs/core": "^11.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@nestjs/platform-express": "^11.1.24",
    "eslint": "^9.37.0",
    "eslint-plugin-jsdoc": "^61.1.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
